#!/usr/bin/env bash
set -euo pipefail

_self=${BASH_SOURCE[0]}
while [ -L "$_self" ]; do
  _dir=$(cd -P "$(dirname -- "$_self")" && pwd)
  _self=$(readlink -- "$_self")
  case $_self in
    /*) ;;
    *)  _self=$_dir/$_self ;;
  esac
done
SCRIPT_DIR=$(cd -P "$(dirname -- "$_self")" && pwd)

# shellcheck source=./lib/workspace.sh
. "$SCRIPT_DIR/lib/workspace.sh"

USAGE='Usage: worktree-create [options] [<repo>] <scope/branch-name>

  -b, --base <ref>   base branch (default: the repository'"'"'s default branch)
      --no-fetch     do not fetch before creating
      --no-hooks     skip .workflow/post-create
      --no-env       do not copy ignored local files such as .env
      --no-scratch   do not create the .scratch symlink
      --force        reuse an existing empty directory at the target path
  -y, --yes          assume yes to prompts
  -h, --help         show this help

Creates worktrees/<repo>/<scope-branch-name> and prints its path on stdout:

  cd "$(scripts/worktree-create app feat/login)"

<repo> may be omitted when the workspace holds exactly one repository, or when
the current directory is already inside repos/<repo> or worktrees/<repo>.'

base=
fetch=1
hooks=1
copy_env=1
scratch=1
force=0
positional=

while [ $# -gt 0 ]; do
  case $1 in
    -b|--base)    shift; [ $# -gt 0 ] || usage_die "--base needs a value"; base=$1 ;;
    --base=*)     base=${1#--base=} ;;
    --no-fetch)   fetch=0 ;;
    --no-hooks)   hooks=0; WORKFLOW_NO_HOOKS=1; export WORKFLOW_NO_HOOKS ;;
    --no-env)     copy_env=0 ;;
    --no-scratch) scratch=0 ;;
    --force)      force=1 ;;
    -y|--yes)     WORKFLOW_YES=1; export WORKFLOW_YES ;;
    -h|--help)    printf '%s\n' "$USAGE"; exit 0 ;;
    --)           shift; break ;;
    -*)           usage_die "unknown option: $1" ;;
    *)            positional=$positional$1$'\n' ;;
  esac
  shift
done

while [ $# -gt 0 ]; do
  positional=$positional$1$'\n'
  shift
done

ws_require_workspace

repo=
branch=
count=0
while IFS= read -r arg; do
  [ -n "$arg" ] || continue
  count=$((count + 1))
  case $count in
    1) repo=$arg ;;
    2) branch=$arg ;;
    *) usage_die "unexpected argument: $arg" ;;
  esac
done <<EOT
$positional
EOT

case $count in
  0) usage_die "missing <scope/branch-name>" ;;
  1)
    branch=$repo
    repo=$(ws_infer_repo) || die 2 \
      "cannot tell which repository you mean" \
      "pass it explicitly: worktree-create <repo> $branch" \
      "known repositories: $(ws_list_repos | tr '\n' ' ')"
    ;;
esac

ws_check_branch "$branch"
repo_dir=$(ws_repo_dir "$repo")

if ! git -C "$repo_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  die 3 "repos/$repo is not a git working tree"
fi

wt_dir=$(ws_wt_path "$repo" "$branch")
wt_name=$(ws_sanitize "$branch")

log_step "creating worktree $repo $branch"

# Always prune first: a stale record left by a hand-deleted directory is the
# most common confusing failure here, and clearing it costs nothing.
git -C "$repo_dir" worktree prune

if [ "$fetch" = 1 ]; then
  if git -C "$repo_dir" remote get-url origin >/dev/null 2>&1; then
    # A failed fetch is a warning: creating a branch offline is legitimate.
    git -C "$repo_dir" fetch --prune --quiet origin || \
      log_warn "fetch failed; continuing from local refs"
  else
    log_warn "repos/$repo has no 'origin' remote; using local refs only"
  fi
fi

if [ -z "$base" ]; then
  base=$(ws_default_branch "$repo_dir" 2>/dev/null) || base=
fi
if [ -z "$base" ]; then
  die 3 "cannot determine a base branch for '$repo'" \
        "pass --base <ref>, or set one:" \
        "  git -C repos/$repo config workflow.baseBranch main"
fi

# --- target path -------------------------------------------------------------

registered_branch=
registered_is_target=0
while IFS=$'\t' read -r p b f; do
  [ -n "$p" ] || continue
  if [ "$p" = "$wt_dir" ]; then
    registered_is_target=1
    registered_branch=$b
    break
  fi
  if [ -d "$p" ] && [ -d "$wt_dir" ] && [ "$(ws_realpath "$p")" = "$(ws_realpath "$wt_dir")" ]; then
    registered_is_target=1
    registered_branch=$b
    break
  fi
done <<EOT
$(ws_worktree_records "$repo_dir")
EOT

if [ "$registered_is_target" = 1 ]; then
  if [ "$registered_branch" = "$branch" ]; then
    log_success "worktree already exists"
    log_info "cd $(ws_rel "$wt_dir")"
    printf '%s\n' "$wt_dir"
    exit 0
  fi
  die 4 "worktrees/$repo/$wt_name is already the worktree for '${registered_branch:-a detached HEAD}'" \
        "two branch names can sanitize to one directory; rename one of them"
fi

if [ -e "$wt_dir" ]; then
  if [ "$force" != 1 ]; then
    die 4 "$(ws_rel "$wt_dir") already exists" \
          "pass --force to reuse it, if it is empty"
  fi
  # rmdir refuses a non-empty directory, which is exactly the guard we want.
  # This script never runs rm -rf.
  rmdir "$wt_dir" || die 4 "$(ws_rel "$wt_dir") is not empty; refusing to touch it"
fi

# --- create ------------------------------------------------------------------

local_exists=0
if git -C "$repo_dir" show-ref --verify --quiet "refs/heads/$branch"; then
  local_exists=1
fi
remote_exists=0
if git -C "$repo_dir" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
  remote_exists=1
fi

checked_out=$(ws_branch_worktree "$repo_dir" "$branch") || checked_out=
if [ -n "$checked_out" ]; then
  die 4 "branch '$branch' is already checked out at $(ws_rel "$checked_out")"
fi

mkdir -p "$(dirname "$wt_dir")"

if [ "$local_exists" = 1 ]; then
  log_info "start    existing local branch $branch"
  git -C "$repo_dir" worktree add "$wt_dir" "$branch" >/dev/null
elif [ "$remote_exists" = 1 ]; then
  log_info "start    origin/$branch"
  git -C "$repo_dir" worktree add --track -b "$branch" "$wt_dir" "origin/$branch" >/dev/null
else
  base_ref=$(ws_base_ref "$repo_dir" "$base")
  log_info "base     $base_ref"
  # --no-track: branching from origin/<base> would otherwise make <base> the
  # upstream, which breaks `git push` defaults and makes a new branch look
  # merged. The upstream arrives with the first `git push -u origin <branch>`.
  git -C "$repo_dir" worktree add --no-track -b "$branch" "$wt_dir" "$base_ref" >/dev/null
fi

log_info "path     $(ws_rel "$wt_dir")"

# --- ignored local files -----------------------------------------------------

if [ "$copy_env" = 1 ]; then
  patterns=$(git -C "$repo_dir" config --get-all workflow.copyIgnored 2>/dev/null) || patterns=
  if [ -z "$patterns" ]; then
    patterns=$'.env\n.env.*\n.envrc'
  fi

  set --
  while IFS= read -r pat; do
    [ -n "$pat" ] || continue
    set -- "$@" "$pat"
  done <<EOT
$patterns
EOT

  if [ $# -gt 0 ]; then
    # --others --ignored --exclude-standard lists exactly the ignored, untracked
    # files. .env.example never appears: the template .gitignore un-ignores it,
    # which makes it tracked, so it arrives with the checkout instead.
    git -C "$repo_dir" ls-files --others --ignored --exclude-standard -z -- "$@" 2>/dev/null |
      while IFS= read -r -d '' f; do
        [ -f "$repo_dir/$f" ] || continue
        if [ -e "$wt_dir/$f" ]; then
          log_detail "skip $f (already present)"
          continue
        fi
        mkdir -p "$wt_dir/$(dirname "$f")"
        cp -p "$repo_dir/$f" "$wt_dir/$f"
        log_info "copied   $f"
      done
  fi
fi

# --- workspace scratch -------------------------------------------------------

slug=$(ws_slug "$branch")

if [ "$scratch" = 1 ]; then
  mkdir -p "$SCRATCH_DIR/active/$slug"
  ln -sfn ../../../scratch/active "$wt_dir/.scratch"

  if ! git -C "$wt_dir" check-ignore -q .scratch 2>/dev/null; then
    excl=$(git -C "$wt_dir" rev-parse --git-path info/exclude)
    case $excl in
      /*) ;;
      *)  excl=$wt_dir/$excl ;;
    esac
    mkdir -p "$(dirname "$excl")"
    # info/ is a COMMON path in git's worktree layout, so this file is shared by
    # every worktree of the repository. Append once, or every create adds a line.
    if ! grep -qxF '.scratch' "$excl" 2>/dev/null; then
      printf '%s\n' '.scratch' >> "$excl"
    fi
  fi
  log_info "scratch  scratch/active/$slug"
fi

# --- hook --------------------------------------------------------------------

if [ "$hooks" = 1 ]; then
  ws_hook_env post-create "$repo" "$repo_dir" "$branch" "$wt_dir" "$base"
  if ! ws_run_hook post-create; then
    log_error "post-create hook failed"
    log_info "the worktree is intact; fix the hook and re-run it, or discard it:"
    log_detail "scripts/worktree-retire $repo $branch"
    exit 5
  fi
fi

log_success "worktree ready"
log_info "cd $(ws_rel "$wt_dir")"

printf '%s\n' "$wt_dir"
