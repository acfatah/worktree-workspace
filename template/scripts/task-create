#!/usr/bin/env bash
set -euo pipefail

_self=${BASH_SOURCE[0]}
while [ -L "$_self" ]; do
  _dir=$(cd -P "$(dirname -- "$_self")" && pwd)
  _self=$(readlink -- "$_self")
  case $_self in
    /*) ;;
    *)  _self=$_dir/$_self ;;
  esac
done
SCRIPT_DIR=$(cd -P "$(dirname -- "$_self")" && pwd)

# shellcheck source=./lib/workspace.sh
. "$SCRIPT_DIR/lib/workspace.sh"

# The $(...) in the example is meant literally.
# shellcheck disable=SC2016
USAGE='Usage: task-create [options] <branch> <repo>...

  -b, --base <ref>   base for repositories where <branch> is new
                     (default: each repository'"'"'s base branch)
      --no-fetch     do not fetch before creating
      --no-hooks     skip .workflow/post-create
      --no-shared    do not copy shared/<repo>/ into new worktrees
  -h, --help         show this help

Creates tasks/<task>/ (the branch with "/" turned into "-") holding
CLAUDE.md, NOTES.md, .claude/plans/ and one worktree per repository, all on
<branch>. Prints the task path on stdout:

  cd "$(scripts/task-create feat/login app api)"

Every repository is checked before anything is created. Re-running resumes
a task that stopped partway: existing worktrees are skipped.

An env branch, such as main, is never a task: check it out with
scripts/branch-add instead.'

base=
fetch=1
hooks=1
shared=1
branch=
repos=()

add_positional() {
  if [ -z "$branch" ]; then
    branch=$1
  else
    repos+=("$1")
  fi
}

while [ $# -gt 0 ]; do
  case $1 in
    -b|--base)    shift; [ $# -gt 0 ] || usage_die "--base needs a value"; base=$1 ;;
    --base=*)     base=${1#--base=} ;;
    --no-fetch)   fetch=0 ;;
    --no-hooks)   hooks=0 ;;
    --no-shared)  shared=0 ;;
    -h|--help)    printf '%s\n' "$USAGE"; exit 0 ;;
    --)           shift; break ;;
    -*)           usage_die "unknown option: $1" ;;
    *)            add_positional "$1" ;;
  esac
  shift
done

while [ $# -gt 0 ]; do
  add_positional "$1"
  shift
done

[ -n "$branch" ] || usage_die "missing <branch>"
[ "${#repos[@]}" -gt 0 ] || usage_die "missing <repo>"

ws_require_workspace
ws_check_branch "$branch"

task=$(ws_task_name "$branch")
task_dir=$(ws_task_dir "$task")

# --- check -------------------------------------------------------------------

dirs=()
seen=' '
for repo in "${repos[@]}"; do
  case $seen in
    *" $repo "*) usage_die "repository listed twice: $repo" ;;
  esac
  seen="$seen$repo "
  dir=$(ws_repo_dir "$repo")
  if ws_is_env_branch "$branch" "$dir"; then
    die 4 "'$branch' is an env branch of $repo, not a task" \
          "check it out with: scripts/branch-add $branch ${repos[*]}"
  fi
  dirs+=("$dir")
done

if [ "$fetch" = 1 ]; then
  for i in "${!repos[@]}"; do
    # A failed fetch is a warning: creating a branch offline is legitimate.
    git -C "${dirs[$i]}" fetch --prune --quiet origin 2>/dev/null ||
      log_warn "fetch failed for ${repos[$i]}; continuing from local refs"
  done
fi

bases=()
actions=()
for i in "${!repos[@]}"; do
  repo_base=$base
  if [ -z "$repo_base" ]; then
    repo_base=$(ws_default_branch "${dirs[$i]}" 2>/dev/null) || repo_base=
  fi
  action=$(ws_wt_preflight "$(ws_wt_path "$task" "${repos[$i]}")" "${repos[$i]}" "$branch" "$repo_base")
  bases+=("$repo_base")
  actions+=("$action")
done

# --- create ------------------------------------------------------------------

log_step "task $task (branch $branch)"
ws_write_task_files "$task" "$branch"

for i in "${!repos[@]}"; do
  repo=${repos[$i]}
  wt=$(ws_wt_path "$task" "$repo")

  if [ "${actions[$i]}" = exists ]; then
    log_info "exists   $(ws_rel "$wt")"
    continue
  fi

  log_step "adding $repo"
  ws_wt_create "$wt" "$repo" "$branch" "${bases[$i]}"

  if [ "$shared" = 1 ]; then
    ws_copy_shared "$repo" "$wt"
  fi

  if [ "$hooks" = 1 ]; then
    ws_hook_env post-create "$task" "$repo" "${dirs[$i]}" "$branch" "$wt" "${bases[$i]}"
    if ! ws_run_hook post-create; then
      log_error "post-create hook failed in $repo"
      log_info "the worktree is intact; fix the hook, then re-run it by hand"
      log_info "or re-run this command, which skips worktrees that exist"
      exit 5
    fi
  fi
done

log_success "task ready"
log_info "cd $(ws_rel "$task_dir")"

printf '%s\n' "$task_dir"
