#!/usr/bin/env bash
set -euo pipefail

_self=${BASH_SOURCE[0]}
while [ -L "$_self" ]; do
  _dir=$(cd -P "$(dirname -- "$_self")" && pwd)
  _self=$(readlink -- "$_self")
  case $_self in
    /*) ;;
    *)  _self=$_dir/$_self ;;
  esac
done
SCRIPT_DIR=$(cd -P "$(dirname -- "$_self")" && pwd)

# shellcheck source=./lib/workspace.sh
. "$SCRIPT_DIR/lib/workspace.sh"

USAGE='Usage: repo-add [options] <url> [<name>]

  --name <n>      repository name; the clone goes to repos/<n>.git
                  (default: derived from <url>)
  --branch <b>    branch new tasks start from (default: the remote default);
                  recorded as git config workflow.baseBranch
  -h, --help      show this help

Makes a bare clone at repos/<name>.git with origin/* remote-tracking refs and
the remote default branch pinned. Prints the clone path on stdout.'

url=
name=
branch=

while [ $# -gt 0 ]; do
  case $1 in
    --name)      shift; [ $# -gt 0 ] || usage_die "--name needs a value"; name=$1 ;;
    --name=*)    name=${1#--name=} ;;
    --branch)    shift; [ $# -gt 0 ] || usage_die "--branch needs a value"; branch=$1 ;;
    --branch=*)  branch=${1#--branch=} ;;
    -h|--help)   printf '%s\n' "$USAGE"; exit 0 ;;
    --)          shift; break ;;
    -*)          usage_die "unknown option: $1" ;;
    *)
      if [ -z "$url" ]; then url=$1
      elif [ -z "$name" ]; then name=$1
      else usage_die "unexpected argument: $1"
      fi
      ;;
  esac
  shift
done

while [ $# -gt 0 ]; do
  if [ -z "$url" ]; then url=$1
  elif [ -z "$name" ]; then name=$1
  else usage_die "unexpected argument: $1"
  fi
  shift
done

[ -n "$url" ] || usage_die "missing <url>"

ws_require_workspace

if [ -z "$name" ]; then
  name=${url%/}
  name=${name##*/}
  name=${name%.git}
fi

case $name in
  ''|*[!A-Za-z0-9._-]*|*.git)
    die 2 "cannot use '$name' as a repository name" \
          "pass an explicit name: repo-add $url <name>"
    ;;
esac

if [ -n "$branch" ]; then
  ws_check_branch "$branch"
fi

repo_dir=$REPOS_DIR/$name.git

if [ -e "$repo_dir" ]; then
  die 4 "repos/$name.git already exists"
fi

log_step "cloning $url into repos/$name.git"
mkdir -p "$REPOS_DIR"

# git clone removes its own partial directory on failure. This script never
# deletes anything itself.
git clone --bare "$url" "$repo_dir" || die 7 "clone failed"

# A bare clone has no fetch refspec: it copies the remote's branches into
# refs/heads/ once and never updates them. Map them to origin/* instead, so
# fetches keep them current and worktrees can track them.
git -C "$repo_dir" config remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*'
if ! git -C "$repo_dir" fetch --prune --quiet origin; then
  die 7 "fetch into repos/$name.git failed" \
        "retry with: git -C repos/$name.git fetch --prune origin"
fi

# Pin refs/remotes/origin/HEAD now, while we are certainly online, so that a
# base branch resolves later even without a network.
git -C "$repo_dir" remote set-head origin --auto >/dev/null 2>&1 || \
  log_warn "could not determine the remote default branch"

# The copied local branches would go stale and shadow origin/*. Keep only the
# branch HEAD points at, since a bare repository needs one, and let it track
# origin like any other.
head=$(git -C "$repo_dir" symbolic-ref --quiet --short HEAD 2>/dev/null) || head=
while IFS= read -r b; do
  [ -n "$b" ] || continue
  [ "$b" != "$head" ] || continue
  git -C "$repo_dir" branch -q -D "$b"
done <<EOT
$(git -C "$repo_dir" for-each-ref --format='%(refname:short)' refs/heads/)
EOT
if [ -n "$head" ] && git -C "$repo_dir" rev-parse --verify --quiet "refs/remotes/origin/$head" >/dev/null; then
  git -C "$repo_dir" config "branch.$head.remote" origin
  git -C "$repo_dir" config "branch.$head.merge" "refs/heads/$head"
fi

if [ -n "$branch" ]; then
  git -C "$repo_dir" config workflow.baseBranch "$branch"
  if ! git -C "$repo_dir" rev-parse --verify --quiet "refs/remotes/origin/$branch" >/dev/null; then
    log_warn "origin/$branch does not exist; new tasks will fail to branch from it"
  fi
fi

base=$(ws_default_branch "$repo_dir" 2>/dev/null) || base='(unknown)'

log_success "repos/$name.git ready"
log_info "base branch  $base"
log_step "next: start a task with this repository"
log_info "scripts/task-create <branch> $name"

printf '%s\n' "$repo_dir"
