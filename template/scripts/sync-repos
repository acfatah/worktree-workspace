#!/usr/bin/env bash
set -euo pipefail

_self=${BASH_SOURCE[0]}
while [ -L "$_self" ]; do
  _dir=$(cd -P "$(dirname -- "$_self")" && pwd)
  _self=$(readlink -- "$_self")
  case $_self in
    /*) ;;
    *)  _self=$_dir/$_self ;;
  esac
done
SCRIPT_DIR=$(cd -P "$(dirname -- "$_self")" && pwd)

# shellcheck source=./lib/workspace.sh
. "$SCRIPT_DIR/lib/workspace.sh"

USAGE='Usage: sync-repos [options] [<repo>...]

  --no-prune      do not pass --prune to fetch
  --no-tags       do not fetch tags
  --fail-fast     stop at the first failure
  -h, --help      show this help

Fast-forwards every main clone under repos/. Never merges, rebases or resets:
a repository that cannot fast-forward is reported, not rewritten.'

prune=1
tags=1
fail_fast=0
names=

while [ $# -gt 0 ]; do
  case $1 in
    --no-prune)  prune=0 ;;
    --no-tags)   tags=0 ;;
    --fail-fast) fail_fast=1 ;;
    -h|--help)   printf '%s\n' "$USAGE"; exit 0 ;;
    --)          shift; break ;;
    -*)          usage_die "unknown option: $1" ;;
    *)           names=$names$1$'\n' ;;
  esac
  shift
done

while [ $# -gt 0 ]; do
  names=$names$1$'\n'
  shift
done

ws_require_workspace

if [ -z "$names" ]; then
  names=$(ws_list_repos)
  if [ -n "$names" ]; then
    names=$names$'\n'
  fi
fi

if [ -z "$names" ]; then
  log_warn "no repositories under repos/"
  log_detail "add one with: scripts/repo-add <url>"
  exit 0
fi

rows=
n_updated=0
n_current=0
n_skipped=0
n_failed=0

record() { rows=$rows$1$'\t'$2$'\t'$3$'\n'; }

while IFS= read -r name; do
  [ -n "$name" ] || continue

  dir=$REPOS_DIR/$name
  if [ ! -e "$dir/.git" ]; then
    log_warn "repos/$name is not a git repository"
    record "$name" skipped "not a git repository"
    n_skipped=$((n_skipped + 1))
    continue
  fi

  log_step "$name"

  if ! git -C "$dir" remote get-url origin >/dev/null 2>&1; then
    record "$name" skipped "no origin remote"
    n_skipped=$((n_skipped + 1))
    continue
  fi

  fetch_opts=
  if [ "$prune" = 1 ]; then fetch_opts="$fetch_opts --prune"; fi
  if [ "$tags" = 1 ]; then fetch_opts="$fetch_opts --tags"; fi

  # shellcheck disable=SC2086
  if ! git -C "$dir" fetch $fetch_opts --quiet origin; then
    record "$name" failed "fetch failed"
    n_failed=$((n_failed + 1))
    if [ "$fail_fast" = 1 ]; then break; fi
    continue
  fi

  head=$(git -C "$dir" symbolic-ref --quiet --short HEAD 2>/dev/null) || head=
  if [ -z "$head" ]; then
    record "$name" skipped "detached HEAD"
    n_skipped=$((n_skipped + 1))
    continue
  fi

  if ws_is_dirty "$dir"; then
    record "$name" skipped "uncommitted changes on $head"
    n_skipped=$((n_skipped + 1))
    continue
  fi

  default=$(ws_default_branch "$dir" 2>/dev/null) || default=
  if [ -n "$default" ] && [ "$default" != "$head" ]; then
    log_warn "main clone is on '$head', not the default branch '$default'"
    # git refuses to fetch into a branch that is checked out anywhere, so this
    # is a no-op in exactly the case where it would be dangerous.
    git -C "$dir" fetch --quiet origin "$default:$default" 2>/dev/null || true
  fi

  if ! git -C "$dir" rev-parse --verify --quiet "$head@{upstream}" >/dev/null 2>&1; then
    record "$name" skipped "no upstream for $head"
    n_skipped=$((n_skipped + 1))
    continue
  fi

  before=$(git -C "$dir" rev-parse --short HEAD)
  if ! git -C "$dir" merge --ff-only --quiet "@{upstream}" 2>/dev/null; then
    record "$name" failed "$head is not fast-forwardable"
    n_failed=$((n_failed + 1))
    if [ "$fail_fast" = 1 ]; then break; fi
    continue
  fi
  after=$(git -C "$dir" rev-parse --short HEAD)

  if [ "$before" = "$after" ]; then
    record "$name" up-to-date "$head"
    n_current=$((n_current + 1))
  else
    count=$(git -C "$dir" rev-list --count "$before..$after")
    record "$name" updated "$head  $before..$after ($count commits)"
    n_updated=$((n_updated + 1))
  fi
done <<EOT
$names
EOT

w_name=4
w_state=6
while IFS=$'\t' read -r name state detail; do
  [ -n "$name" ] || continue
  if [ ${#name} -gt $w_name ]; then w_name=${#name}; fi
  if [ ${#state} -gt $w_state ]; then w_state=${#state}; fi
done <<EOT
$rows
EOT

while IFS=$'\t' read -r name state detail; do
  [ -n "$name" ] || continue
  # Pad first, colour second: escape bytes must not enter the width maths.
  padded_state=$(printf '%-*s' "$w_state" "$state")
  case $state in
    updated)    painted=$(PC_green "$padded_state") ;;
    up-to-date) painted=$(PC_dim "$padded_state") ;;
    skipped)    painted=$(PC_yellow "$padded_state") ;;
    *)          painted=$(PC_red "$padded_state") ;;
  esac
  printf '%-*s  %s  %s\n' "$w_name" "$name" "$painted" "$detail"
done <<EOT
$rows
EOT

log_info ""
log_success "$n_updated updated, $n_current up to date, $n_skipped skipped, $n_failed failed"

if [ "$n_failed" -gt 0 ]; then
  exit 7
fi
exit 0
